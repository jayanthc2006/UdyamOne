UDYAMONE_LLM_API_KEY=replace-with-your-provider-key
UDYAMONE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
UDYAMONE_LLM_MODEL=gemini-3.1-flash-lite
UDYAMONE_LLM_TIMEOUT_SECONDS=60
# Comma-separated approved document types; blank means none are mandatory.
UDYAMONE_KYC_REQUIRED_DOCUMENTS=

# Competition-prototype KYC authentication only; never use as production auth.
# Configure a random signing secret of at least 32 bytes and JSON user records
# with PBKDF2 hashes, backend-assigned roles, and customer applicant_ids.
UDYAMONE_KYC_AUTH_SECRET=
UDYAMONE_KYC_AUTH_USERS=